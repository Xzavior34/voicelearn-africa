# VoiceLearn Africa — environment configuration
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Sahara (primary speech provider) ---
# STATUS: REQUIRES_API_ACCESS until you add a real key below.
# Official contract: https://docs.voice.intron.io/
# Endpoint: wss://infer.voice.intron.io/stt/v1/stream (default — override
# only if Intron gives you a different/staging endpoint).
SAHARA_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_API_KEY=

# --- Benchmark comparison providers (optional, benchmark only) ---
# Point these at any real ASR REST endpoint (multipart audio in,
# { transcript, confidence? } JSON out) to make the 3-model benchmark
# fully live. See lib/speech/providers/generic-rest-provider.ts.
MODEL_B_API_URL=
MODEL_B_API_KEY=
MODEL_C_API_URL=
MODEL_C_API_KEY=
