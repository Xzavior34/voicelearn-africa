# VoiceLearn Africa — Environment Configuration
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# =============================================================================
# 1. Intron Sahara v2.5 (Primary Live Speech Provider — Required for Challenge)
# =============================================================================
# Official Documentation: https://docs.voice.intron.io/
# Endpoint: wss://infer.voice.intron.io/stt/v1/stream
SAHARA_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_API_KEY=

# =============================================================================
# 2. Local Open-Source Benchmark Models (ZERO PAID API KEYS REQUIRED)
# =============================================================================
# Model B: OpenAI Whisper Large v3 (Apache-2.0, local inference via PyTorch/Transformers)
# Model C: Meta Wav2Vec2 Large 960h (Apache-2.0, local inference via PyTorch/Transformers)
# Model weights download automatically from Hugging Face cache on first benchmark run.
#
# Optional custom model identifier overrides (model identifiers, NOT secrets):
WHISPER_MODEL_ID=openai/whisper-large-v3
WAV2VEC2_MODEL_ID=facebook/wav2vec2-large-960h
# Optional Python interpreter path if not on default system PATH:
# PYTHON_PATH=C:\Python314\python.exe
