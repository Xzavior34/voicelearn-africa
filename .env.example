# VoiceLearn Africa — Environment Configuration
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# =============================================================================
# 1. Intron Sahara v2.5 (PRODUCTION Speech Provider — Required for Challenge)
# =============================================================================
# Official Documentation: https://docs.voice.intron.io/
# Endpoint: wss://infer.voice.intron.io/stt/v1/stream
SAHARA_WS_URL=wss://infer.voice.intron.io/stt/v1/stream
SAHARA_API_KEY=

# =============================================================================
# 2. Local Benchmark-Only Models (ZERO PAID API KEYS, FILESYSTEM-ONLY)
# =============================================================================
# Model B: OpenAI Whisper Tiny (Apache-2.0) — BENCHMARK COMPARATOR ONLY
# Model C: Meta Wav2Vec2 Base 960h (Apache-2.0) — BENCHMARK COMPARATOR ONLY,
#          an English/LibriSpeech baseline, NOT an African-language specialist.
# Neither model is ever used in the production learner-facing app — only Sahara is.
#
# These models are NEVER downloaded automatically. You must download the
# model files yourself and place them at the paths below.
# See LOCAL_MODEL_SETUP.md for the exact files, folder structure, and
# verification commands.
#
# Repo id labels (informational only — never fetched over the network):
WHISPER_MODEL_ID=openai/whisper-tiny
WAV2VEC2_MODEL_ID=facebook/wav2vec2-base-960h

# Local filesystem folders the model files must be copied into.
# Defaults (used if unset) are relative to the project root:
#   ./models/whisper-tiny
#   ./models/wav2vec2-base-960h
# WHISPER_LOCAL_MODEL_PATH=./models/whisper-tiny
# WAV2VEC2_LOCAL_MODEL_PATH=./models/wav2vec2-base-960h

# Optional Python interpreter path if not on default system PATH:
# PYTHON_PATH=C:\Python314\python.exe
